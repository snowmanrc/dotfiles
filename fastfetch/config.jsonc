{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"type": "auto",        // Logo type: auto, builtin, small, file, etc.
		"source": "arch",      // Built-in logo name or file path
		"width": 60,           // Width in characters
		"height": 10,          // Height in characters
		"padding": {
			"top": 2,          // Top padding
			"left": 10,         // Left padding
			"right": 0         // Right padding
		}
	},
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "┌────────────────────── Hardware ──────────────────────┐",
            "outputColor": "white"
        },
        {
            "type": "host",
            "key": "    PC",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "  󰍛  CPU",
            "showPeCoreCount": true,
            "format": "{1}",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "  󰍛  GPU",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "  󰋊  Disk",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "    Memory",
            "keyColor": "green"
        },
        {
            "type": "swap",
            "key": "    Swap",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────────────┘",
            "outputColor": "white"
        },
        "break",
        {
            "type": "custom",
            "format": "┌────────────────────── Software ──────────────────────┐",
            "outputColor": "white"
        },
        {
            "type": "os",
            "key": "    OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "    Kernel",
            "keyColor": "yellow"
        },
        {
            "type": "bios",
            "key": "    BIOS",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "key": "    OS Age",
            "keyColor": "yellow",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        "break",
        {
            "type": "command",
            "key": "    Hostname",
            "keyColor": "blue",
            "text": "hostnamectl | awk -F': ' '/Static hostname/ {print $2}'"
        },
        {
            "type": "packages",
            "key": "  󰏖  Packages",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "    Shell",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "wm",
            "key": "    WM",
            "keyColor": "magenta"
        },
        {
            "type": "lm",
            "key": "    LM",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "└──────────────────────────────────────────────────────┘",
            "outputColor": "white"
        },
        {
            "type": "custom",
            "format": "               \u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m "
        },
        "break"
    ]
}